/* pages/trading/trading.wxss */
.container {
  padding: 0;
  justify-content: flex-start;
  background: #0B0B15;
}

/* 动态背景补充 */
.cyber-bg {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  overflow: hidden;
  z-index: 0;
}

/* 顶部状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  background: rgba(255, 255, 255, 0.02);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  z-index: 10;
}

.status-item {
  display: flex;
  flex-direction: column;
}

.status-item.capital {
  align-items: flex-end;
}

.status-item .label {
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  margin-bottom: 4rpx;
}

.status-item .value {
  font-size: 36rpx;
  color: var(--text-primary);
  font-weight: bold;
}

.status-item .sub {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-left: 4rpx;
}

/* 资金颜色 */
.capital-up { color: var(--neon-red) !important; text-shadow: 0 0 10rpx rgba(255, 77, 77, 0.3); }
.capital-down { color: var(--neon-green) !important; text-shadow: 0 0 10rpx rgba(0, 230, 118, 0.3); }

/* 主舞台区域 */
.main-stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 30rpx 24rpx;
  z-index: 5;
}

/* HUD 信息层 */
.hud-layer {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.talent-pill, .stock-pill {
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
}

.talent-pill .icon { margin-right: 12rpx; font-size: 28rpx; }
.talent-pill .name { font-size: 24rpx; color: var(--neon-gold); font-weight: bold; }

.stock-pill .code { 
  font-size: 20rpx; color: var(--text-muted); margin-right: 12rpx; 
}
.stock-pill .name { font-size: 24rpx; color: var(--text-primary); }

/* 图表容器 */
.chart-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 24rpx;
  min-height: 600rpx;
  position: relative;
  z-index: 10;
  /* 简化背景，避免某些环境下 backdrop-filter 与 canvas 冲突 */
  background: rgba(22, 22, 42, 0.9); 
}

/* 赛博新闻条 */
.news-ticker-cyber {
  height: 60rpx;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.news-icon-box {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  background: rgba(255, 255, 255, 0.05);
}

.icon-pulse { 
  font-size: 20rpx; margin-right: 10rpx; 
  animation: pulse-red 1s infinite;
}

@keyframes pulse-red {
  0% { opacity: 0.5; } 50% { opacity: 1; } 100% { opacity: 0.5; }
}

.news-icon-box .icon-text {
  font-size: 20rpx; font-weight: bold; letter-spacing: 2rpx;
  color: var(--text-secondary);
}

.news-track {
  flex: 1;
  overflow: hidden;
  position: relative;
  display: flex;
  align-items: center;
}

.news-scroller {
  position: absolute;
  white-space: nowrap;
  animation: scroll-left 15s linear infinite;
  padding-left: 100%;
}

@keyframes scroll-left {
  0% { transform: translateX(0); }
  100% { transform: translateX(-100%); }
}

.news-item {
  font-size: 24rpx; color: var(--text-primary);
}

.chart-canvas-box {
  width: 100%;
  height: 600rpx; /* 强制指定高度，防止一些设备上 flex 渲染为 0 */
  position: relative;
}

ec-canvas { 
  display: block;
  width: 100%; 
  height: 100%; 
  position: relative;
  z-index: 11;
}

/* 底部控制台 */
.control-deck {
  padding: 40rpx 32rpx;
  background: rgba(11, 11, 21, 0.95);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20px);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.hint-text {
  text-align: center;
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 4rpx;
  margin-bottom: 30rpx;
}

.button-group {
  display: flex;
  gap: 30rpx;
}

.cyber-btn {
  flex: 1;
  height: 120rpx;
  border-radius: 20rpx;
  border: none;
  padding: 0;
  transition: all 0.2s;
}

.cyber-btn::after { display: none; }
.cyber-btn:active { transform: scale(0.96); filter: brightness(0.9); }

.btn-inner {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-inner .icon { font-size: 48rpx; margin-right: 20rpx; }
.btn-inner .text-group { display: flex; flex-direction: column; align-items: flex-start; }
.btn-inner .main { font-size: 32rpx; font-weight: 900; letter-spacing: 2rpx; line-height: 1.2; }
.btn-inner .sub { font-size: 20rpx; opacity: 0.7; }

.btn-long {
  background: linear-gradient(135deg, rgba(255, 77, 77, 0.2) 0%, rgba(255, 0, 0, 0.1) 100%);
  border: 1rpx solid rgba(255, 77, 77, 0.4);
  color: #FF4D4D;
  box-shadow: 0 0 30rpx rgba(255, 77, 77, 0.1);
}

.btn-wait {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #FFF;
}

/* 结果覆盖层 */
.result-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  /* 强制实色背景，彻底屏蔽物理层数据 */
  background: #0B0B15; 
  z-index: 9999; /* 绝对顶层，覆盖所有原生组件 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 让卡片此时可以点击 */
.result-glass-card {
  pointer-events: auto;
  width: 85%; /* 调整宽度，确保居中更美观 */
  max-width: 600rpx;
  padding: 60rpx 40rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 40rpx 80rpx rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  
  /* 进场动画 */
  transform: scale(0.9);
  opacity: 0;
  animation: result-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes result-pop {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.result-glass-card.win { border-color: var(--neon-red); box-shadow: 0 0 60rpx rgba(255, 77, 77, 0.15); }
.result-glass-card.lose { border-color: var(--neon-green); box-shadow: 0 0 60rpx rgba(0, 230, 118, 0.15); }
.result-glass-card.dodge { border-color: var(--neon-gold); box-shadow: 0 0 60rpx rgba(255, 215, 0, 0.15); }

.result-header { 
  display: flex; 
  align-items: center; 
  margin-bottom: 24rpx; 
}

.result-header .emoji { font-size: 56rpx; margin-right: 16rpx; }
.result-header .title { font-size: 40rpx; font-weight: 900; letter-spacing: 2rpx; color: #FFF; }

.result-value { 
  text-align: center; 
  width: 100%;
  padding-bottom: 30rpx;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.result-value .change { 
  font-size: 80rpx; 
  font-weight: bold; 
  display: block; 
  line-height: 1;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}

.result-value .message { 
  font-size: 26rpx; 
  color: var(--text-secondary); 
  line-height: 1.4;
  display: block;
}

/* 涨跌颜色补全 */
.result-value .change.rise { color: var(--neon-red); }
.result-value .change.fall { color: var(--neon-green); }

.quote-box {
  background: rgba(255, 255, 255, 0.08);
  padding: 24rpx 30rpx;
  border-radius: 16rpx;
  border-left: 6rpx solid var(--neon-gold);
  width: 100%;
  box-sizing: border-box;
}
.quote-box .quote { 
  font-style: italic; 
  color: #DDD; /* 提高对比度 */
  font-size: 24rpx; 
  display: block;
  text-align: left;
  line-height: 1.5;
}

/* 全局Loader */
.cyber-loader {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 50;
}

.loader-ring {
  width: 100rpx; height: 100rpx;
  border: 8rpx solid rgba(255, 255, 255, 0.1);
  border-top-color: var(--neon-gold);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loader-text { font-size: 24rpx; letter-spacing: 4rpx; color: var(--neon-gold); }
@keyframes spin { to { transform: rotate(360deg); } }

/* 特效背景 */
.effect-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; transition: background 0.5s; }
