<!--pages/trading/trading.wxml-->
<view class="container">
  <!-- 顶部信息栏 -->
  <view class="header-bar">
    <view class="level-info">
      <text class="level-label">第</text>
      <text class="level-num">{{currentLevel}}</text>
      <text class="level-label">/{{totalLevels}} 关</text>
    </view>
    <view class="capital-info">
      <text class="capital-label">总资产</text>
      <text class="capital-value {{capitalClass}}">¥{{capitalDisplay}}</text>
    </view>
  </view>

  <!-- K线图表区 -->
  <view class="chart-section">
    <view class="chart-header">
      <text class="chart-title">{{stockName}}</text>
      <text class="chart-hint">观察60天走势，预测明日涨跌</text>
    </view>
    <view class="chart-container">
      <ec-canvas id="kline-chart" canvas-id="kline-canvas" ec="{{ec}}"></ec-canvas>
    </view>
  </view>

  <!-- 决策按钮区 -->
  <view class="action-section" wx:if="{{!showingResult}}">
    <view class="action-hint">你的决策</view>
    <view class="action-buttons">
      <button class="action-btn btn-buy" bindtap="handleBuy" disabled="{{isProcessing}}">
        <text class="btn-icon">🔴</text>
        <text class="btn-label">全仓买入</text>
        <text class="btn-desc">看涨明日</text>
      </button>
      <button class="action-btn btn-wait" bindtap="handleWait" disabled="{{isProcessing}}">
        <text class="btn-icon">⚪</text>
        <text class="btn-label">空仓观望</text>
        <text class="btn-desc">保持现金</text>
      </button>
    </view>
  </view>

  <!-- 结果展示区 -->
  <view class="result-section {{resultAnimation}}" wx:if="{{showingResult}}">
    <view class="result-card {{resultType}}">
      <text class="result-emoji">{{resultEmoji}}</text>
      <text class="result-title">{{resultTitle}}</text>
      <text class="result-change {{resultChangeClass}}">{{resultChangeText}}</text>
      <text class="result-message">{{resultMessage}}</text>
    </view>
  </view>

  <!-- Loading 遮罩 -->
  <view class="loading-overlay" wx:if="{{isProcessing}}">
    <view class="loading-content">
      <view class="loading-spinner"></view>
      <text class="loading-text">揭晓中...</text>
    </view>
  </view>

  <!-- 背景特效 -->
  <view class="effect-bg {{effectClass}}"></view>
</view>
