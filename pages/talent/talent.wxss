/* pages/talent/talent.wxss */
.container {
  padding: 40rpx 32rpx;
  background: linear-gradient(180deg, #0B0B15 0%, #101020 100%);
}

/* 背景粒子补充 */
.cyber-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.particle.p3 {
  width: 600rpx; height: 600rpx;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.05) 0%, transparent 70%);
  top: 10%; left: 50%;
  transform: translateX(-50%);
  border-radius: 50%;
  filter: blur(40rpx);
  animation: pulse-bg 4s infinite ease-in-out;
}

@keyframes pulse-bg {
  0%, 100% { opacity: 0.5; transform: translateX(-50%) scale(1); }
  50% { opacity: 0.8; transform: translateX(-50%) scale(1.1); }
}

/* 标题区 */
.header {
  text-align: center;
  margin-bottom: 50rpx;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-badge {
  font-size: 20rpx;
  color: var(--neon-gold);
  border: 1rpx solid rgba(255, 215, 0, 0.3);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.title {
  font-family: var(--font-num);
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 4rpx;
}

/* 天赋容器 */
.talents-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 60rpx;
  z-index: 1;
}

/* --- 全息卡片 --- */
.talent-card {
  position: relative;
  height: 220rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  backdrop-filter: blur(10px);
}

/* 选中状态 */
.talent-card.selected {
  background: rgba(255, 215, 0, 0.08);
  border-color: var(--neon-gold);
  transform: scale(1.02);
  box-shadow: 0 0 30rpx rgba(255, 215, 0, 0.2);
}

/* 扫描线动画 */
.scan-line {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.05), transparent);
  transform: translateY(-100%);
  animation: scan 3s infinite linear;
  pointer-events: none;
}

@keyframes scan {
  0% { transform: translateY(-100%); }
  100% { transform: translateY(100%); }
}

/* 内容布局 */
.card-content {
  display: flex;
  align-items: center;
  width: 100%;
}

.talent-icon-box {
  width: 100rpx;
  height: 100rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.icon-text { font-size: 50rpx; }

.talent-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  flex: 1;
}

.divider {
  width: 2rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.1);
  margin: 0 24rpx;
}

.talent-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  width: 240rpx;
  line-height: 1.4;
  text-align: right;
}

/* 稀有度角标 */
.rarity-badge {
  position: absolute;
  top: 0; right: 0;
  padding: 8rpx 20rpx;
  background: rgba(0, 0, 0, 0.5);
  border-bottom-left-radius: 20rpx;
  font-size: 20rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  z-index: 2;
}

/* 不同稀有度的颜色处理 */
.talent-card.rarity-rare .talent-name { color: #00BFFF; text-shadow: 0 0 10rpx rgba(0, 191, 255, 0.5); }
.talent-card.rarity-epic .talent-name { color: #9D00FF; text-shadow: 0 0 10rpx rgba(157, 0, 255, 0.5); }
.talent-card.rarity-legendary .talent-name { color: #FFD700; text-shadow: 0 0 10rpx rgba(255, 215, 0, 0.5); }

/* 底部按钮 */
.action-section {
  width: 100%;
  margin-top: auto;
  z-index: 1;
}

.confirm-btn {
  width: 100%;
  height: 110rpx;
  border-radius: 55rpx;
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  justify-content: center;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s;
}

.confirm-btn::after { display: none; }

.confirm-btn.active {
  background: var(--neon-gold);
  border: none;
  box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.3);
}

.btn-text {
  font-family: var(--font-num);
  font-weight: 900;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.3);
}

.confirm-btn.active .btn-text {
  color: #0B0B15;
}
