/* pages/welcome/welcome.wxss */
.container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  background: linear-gradient(180deg, #050510 0%, #0B0B15 100%);
}

/* --- 动态背景 --- */
.cyber-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.6;
}

.grid-line {
  position: absolute;
  background: rgba(255, 255, 255, 0.03);
}

.particle {
  position: absolute;
  border-radius: 50%;
  filter: blur(40rpx);
  animation: float 20s infinite ease-in-out;
}

.p1 {
  width: 400rpx; height: 400rpx;
  background: rgba(255, 215, 0, 0.1);
  top: -100rpx; left: -100rpx;
}

.p2 {
  width: 500rpx; height: 500rpx;
  background: rgba(0, 240, 255, 0.05);
  bottom: -100rpx; right: -100rpx;
  animation-delay: -5s;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(40rpx, 60rpx); }
}

/* --- 内容区域 --- */
.content-wrapper {
  z-index: 1;
  width: 100%;
  padding: 0 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

/* LOGO */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo-circle {
  width: 140rpx; height: 140rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 215, 0, 0.3);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
  box-shadow: 0 0 50rpx rgba(255, 215, 0, 0.1);
}

.logo-symbol { font-size: 64rpx; }

.main-title {
  font-family: var(--font-num);
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

.sub-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 12rpx;
  margin-bottom: 24rpx;
}

.tag-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: rgba(255, 215, 0, 0.1);
  color: var(--neon-gold);
  border-radius: 8rpx;
  letter-spacing: 2rpx;
  border: 1rpx solid rgba(255, 215, 0, 0.3);
}

/* 仪表盘 */
.stat-panel {
  width: 100%;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 40rpx 0;
  margin-bottom: 100rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item .label {
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.stat-item .value {
  font-size: 40rpx;
  font-weight: bold;
}

.v-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* 启动按钮 */
.action-area {
  width: 100%;
}

.start-btn {
  width: 100%;
  height: 110rpx;
  border-radius: 20rpx;
  background: var(--neon-gold);
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.3);
  transition: all 0.2s;
  border: none;
}

.start-btn:active {
  transform: scale(0.98);
  filter: brightness(0.9);
}

.btn-text {
  font-family: var(--font-num);
  font-weight: 900;
  font-size: 36rpx;
  color: #0B0B15;
  letter-spacing: 4rpx;
  margin-right: 16rpx;
}

.btn-icon { font-size: 36rpx; }

.slogan-text {
  display: block;
  text-align: center;
  margin-top: 30rpx;
  font-size: 20rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
}
