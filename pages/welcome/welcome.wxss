/* pages/welcome/welcome.wxss */

.container {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx 40rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 50%, #16213e 100%);
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.orbit {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid rgba(239, 35, 42, 0.1);
}

.orbit-1 {
  width: 600rpx;
  height: 600rpx;
  top: -200rpx;
  right: -200rpx;
  animation: rotate 20s linear infinite;
}

.orbit-2 {
  width: 800rpx;
  height: 800rpx;
  bottom: -300rpx;
  left: -300rpx;
  border-color: rgba(20, 177, 67, 0.1);
  animation: rotate 30s linear infinite reverse;
}

.orbit-3 {
  width: 400rpx;
  height: 400rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-color: rgba(255, 215, 0, 0.1);
  animation: pulse 4s ease-in-out infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, rgba(239, 35, 42, 0.2) 0%, rgba(239, 35, 42, 0.05) 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(239, 35, 42, 0.2);
}

.logo-text {
  font-size: 80rpx;
}

.title-group {
  text-align: center;
}

.main-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.sub-title {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 8rpx;
  text-transform: uppercase;
}

/* 信息卡片 */
.info-card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 40rpx 60rpx;
  margin-bottom: 48rpx;
  backdrop-filter: blur(20rpx);
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
}

.info-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-rise);
  font-family: 'DIN Alternate', monospace;
}

.info-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
}

.divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 规则说明 */
.rules-section {
  width: 100%;
  margin-bottom: 60rpx;
}

.rule-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.rule-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.rule-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 开始按钮 */
.button-section {
  width: 100%;
  padding: 0 20rpx;
}

.start-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 108rpx;
  background: linear-gradient(135deg, #ef232a 0%, #ff6b6b 50%, #ef232a 100%);
  background-size: 200% 200%;
  border-radius: 54rpx;
  border: none;
  box-shadow: 0 16rpx 48rpx rgba(239, 35, 42, 0.4);
  animation: gradient 3s ease infinite, pulse 2s ease-in-out infinite;
}

@keyframes gradient {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.start-btn::after {
  display: none;
}

.btn-text {
  font-size: 36rpx;
  font-weight: 600;
  color: white;
  letter-spacing: 4rpx;
}

.btn-arrow {
  font-size: 40rpx;
  color: white;
  margin-left: 16rpx;
  transition: transform 0.3s;
}

.start-btn:active .btn-arrow {
  transform: translateX(8rpx);
}

/* 底部slogan */
.footer {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
}

.slogan {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 2rpx;
}
