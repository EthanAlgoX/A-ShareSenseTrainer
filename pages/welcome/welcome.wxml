<!--pages/welcome/welcome.wxml-->
<view class="container">
  <!-- 动态背景层 -->
  <view class="cyber-bg">
    <view class="grid-line horizontal"></view>
    <view class="grid-line vertical"></view>
    <view class="particle p1"></view>
    <view class="particle p2"></view>
  </view>

  <!-- 核心内容区 -->
  <view class="content-wrapper">
    <!-- LOGO 区 -->
    <view class="logo-area animate-fade-in">
      <view class="logo-circle animate-pulse">
        <text class="logo-symbol">🧬</text>
      </view>
      <text class="main-title text-glow-gold">A股觉醒计划</text>
      <text class="sub-title">A-SHARE AWAKENING</text>
      <view class="tag-badge">量子版本 3.0</view>
    </view>

    <!-- 数据仪表盘 -->
    <view class="glass-card stat-panel animate-fade-in" style="animation-delay: 0.2s">
      <view class="stat-item">
        <text class="label">初始净值</text>
        <text class="value din-font text-glow-gold">¥100,000</text>
      </view>
      <view class="v-divider"></view>
      <view class="stat-item">
        <text class="label">生存协议</text>
        <text class="value din-font">完成 10 轮博弈</text>
      </view>
    </view>

    <!-- 启动按钮 -->
    <view class="action-area animate-fade-in" style="animation-delay: 0.4s">
      <button class="start-btn" bindtap="startGame">
        <text class="btn-text">启动</text>
        <text class="btn-icon">⚡</text>
      </button>
      <text class="slogan-text">风险是生存唯一的筹码</text>
    </view>
  </view>
</view>
