/* pages/result/result.wxss */
.container {
  padding: 40rpx 32rpx;
  background: #0B0B15;
}

/* 背景粒子 */
.cyber-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.particle.p3 {
  width: 800rpx; height: 800rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.03) 0%, transparent 60%);
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  animation: pulse-bg 5s infinite;
}

/* 核心报告卡片 */
.report-card {
  width: 100%;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
  margin-bottom: 30rpx;
  background: rgba(255, 255, 255, 0.03);
  z-index: 1;
}

.report-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; width: 100%; height: 6rpx;
  background: linear-gradient(90deg, var(--neon-gold), var(--neon-red));
}

.report-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.report-title {
  font-size: 20rpx; color: var(--text-muted); letter-spacing: 2rpx;
}

.report-date {
  font-size: 20rpx; color: var(--neon-gold); font-weight: bold;
}

/* 收益展示 */
.profit-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.profit-display .label {
  font-size: 24rpx; color: var(--text-muted); letter-spacing: 4rpx; margin-bottom: 8rpx;
}

.profit-display .value {
  font-size: 64rpx; font-weight: 900; letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.profit-up { color: var(--neon-red); text-shadow: 0 0 20rpx rgba(255, 77, 77, 0.3); }
.profit-down { color: var(--neon-green); text-shadow: 0 0 20rpx rgba(0, 230, 118, 0.3); }

.change-tag {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.change-tag.rise { background: rgba(255, 77, 77, 0.1); color: var(--neon-red); }
.change-tag.fall { background: rgba(0, 230, 118, 0.1); color: var(--neon-green); }

/* 徽章盖章 */
.badge-stamp {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  transform: rotate(-5deg);
  border: 4rpx solid rgba(255, 255, 255, 0.1);
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.2);
}

.stamp-inner {
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
}

.stamp-inner .emoji { font-size: 50rpx; }

/* 徽章背景 */
.badge-legendary { background: linear-gradient(135deg, #FFD700, #FFAA00); }
.badge-epic { background: linear-gradient(135deg, #9b5de5, #f15bb5); }
.badge-rare { background: linear-gradient(135deg, #00bbf9, #00f5d4); }
.badge-gold { background: linear-gradient(135deg, #FFD700, #f4a261); }
.badge-common { background: linear-gradient(135deg, #6a6a8a, #8a8aaa); }
.badge-poor { background: linear-gradient(135deg, #14b143, #0a8a30); }
.badge-worst { background: linear-gradient(135deg, #065a20, #000); }

.badge-info {
  display: flex;
  flex-direction: column;
}

.badge-info .rank { font-size: 20rpx; color: var(--text-muted); }
.badge-info .name { font-size: 36rpx; font-weight: 900; letter-spacing: 2rpx; }

.divider-line {
  width: 100%; height: 2rpx; background: rgba(255, 255, 255, 0.1); margin-bottom: 24rpx;
}

.quote-text {
  font-size: 24rpx; color: var(--text-secondary); font-style: italic; text-align: center;
}

/* 数据网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 20rpx;
  width: 100%;
  margin-bottom: 40rpx;
  z-index: 1;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
}

.stat-box .label { font-size: 18rpx; color: var(--text-muted); margin-bottom: 8rpx; }
.stat-box .value { font-size: 32rpx; font-weight: bold; color: var(--text-primary); }

/* 成就区 */
.achievements-area {
  width: 100%;
  margin-bottom: 40rpx;
  z-index: 1;
}

.section-title {
  font-size: 20rpx; color: var(--text-muted); margin-bottom: 20rpx; letter-spacing: 2rpx;
}

.achievement-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.achievement-card .icon-box {
  font-size: 40rpx; margin-right: 24rpx;
}

.achievement-card .info {
  display: flex; flex-direction: column;
}

.achievement-card .title {
  font-size: 26rpx; color: var(--neon-gold); font-weight: bold;
}

.achievement-card .desc {
  font-size: 22rpx; color: var(--text-secondary);
}

/* 底部按钮 */
.action-footer {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 1;
}

.cyber-btn {
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: var(--font-num);
  font-weight: bold;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  border: none;
}

.cyber-btn::after { display: none; }

.btn-restart {
  background: var(--neon-blue);
  color: #0B0B15;
  box-shadow: 0 0 30rpx rgba(0, 240, 255, 0.3);
}

.btn-share {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #FFF;
}

/* 动画 */
@keyframes bounce-in {
  0% { transform: rotate(-5deg) scale(0); opacity: 0; }
  60% { transform: rotate(-5deg) scale(1.1); opacity: 1; }
  100% { transform: rotate(-5deg) scale(1); }
}

.animate-bounce-in {
  animation: bounce-in 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}
