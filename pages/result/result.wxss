/* pages/result/result.wxss */

.container {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, #0f0f1a 0%, #1a1a2e 50%, #16213e 100%);
  overflow: hidden;
}

/* 背景粒子 */
.bg-particles {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.particle {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 215, 0, 0.3);
  border-radius: 50%;
  animation: float 4s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.3; }
  50% { transform: translateY(-40rpx) scale(1.5); opacity: 0.8; }
}

/* 徽章区域 */
.badge-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.badge {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  animation: badge-pulse 2s ease-in-out infinite;
}

@keyframes badge-pulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 215, 0, 0.4); }
  50% { transform: scale(1.05); box-shadow: 0 0 40rpx 20rpx rgba(255, 215, 0, 0.2); }
}

.badge-legendary { background: linear-gradient(135deg, #ffd700 0%, #ffaa00 50%, #ffd700 100%); }
.badge-epic { background: linear-gradient(135deg, #9b5de5 0%, #f15bb5 100%); }
.badge-rare { background: linear-gradient(135deg, #00bbf9 0%, #00f5d4 100%); }
.badge-gold { background: linear-gradient(135deg, #ffd700 0%, #f4a261 100%); }
.badge-common { background: linear-gradient(135deg, #6a6a8a 0%, #8a8aaa 100%); }
.badge-poor { background: linear-gradient(135deg, #14b143 0%, #0a8a30 100%); }
.badge-worst { background: linear-gradient(135deg, #14b143 0%, #065a20 100%); }

.badge-emoji {
  font-size: 80rpx;
}

.badge-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.badge-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
}

/* 收益展示 */
.profit-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.profit-card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profit-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 12rpx;
}

.profit-value {
  font-size: 56rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', monospace;
  margin-bottom: 16rpx;
}

.profit-value.profit-up { color: #ef232a; }
.profit-value.profit-down { color: #14b143; }

.profit-change-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.profit-change {
  font-size: 32rpx;
  font-weight: 600;
  font-family: 'DIN Alternate', monospace;
}

.profit-percent {
  font-size: 28rpx;
}

.rise { color: #ef232a; }
.fall { color: #14b143; }

/* 统计数据 */
.stats-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.stats-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 24rpx;
  text-align: center;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  font-family: 'DIN Alternate', monospace;
}

.stat-value.rise { color: #ef232a; }
.stat-value.fall { color: #14b143; }
.stat-value.gold { color: #ffd700; }

.stat-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 8rpx;
}

.stats-highlight {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.highlight-item {
  display: flex;
  align-items: center;
  background: rgba(255, 215, 0, 0.1);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.highlight-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.highlight-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 成就展示 */
.achievements-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.achievements-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffd700;
  margin-bottom: 24rpx;
  text-align: center;
}

.achievements-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.achievement-item {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.15) 0%, rgba(255, 215, 0, 0.05) 100%);
  border: 1rpx solid rgba(255, 215, 0, 0.3);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  animation: achievement-glow 2s ease-in-out infinite;
}

.achievement-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.achievement-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.achievement-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffd700;
  margin-bottom: 4rpx;
}

.achievement-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

@keyframes achievement-glow {
  0%, 100% { box-shadow: 0 0 10rpx rgba(255, 215, 0, 0.3); }
  50% { box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.6); }
}

/* 操作按钮 */
.action-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-primary {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #ef232a 0%, #ff6b6b 100%);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  border: none;
  box-shadow: 0 16rpx 40rpx rgba(239, 35, 42, 0.4);
}

.btn-primary::after { display: none; }

.btn-secondary {
  width: 100%;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.btn-secondary::after { display: none; }
