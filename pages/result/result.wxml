<!--pages/result/result.wxml-->
<view class="container">
  <!-- 背景粒子 -->
  <view class="cyber-bg">
    <view class="particle p3"></view>
  </view>

  <!-- 上部分：核心证书区 -->
  <view class="report-card glass-card animate-fade-in">
    <view class="report-header">
      <text class="report-title">TRADING SESSION REPORT</text>
      <text class="report-date">{{finalCapital >= 100000 ? 'PROFITABLE' : 'LIQUIDATED'}}</text>
    </view>

    <!-- 收益数字 -->
    <view class="profit-display">
      <view class="label">FINAL ASSETS</view>
      <text class="value din-font {{profitClass}}">¥{{finalCapital}}</text>
      <view class="change-tag {{profitChangeClass}}">
        <text>{{profitChangeText}} ({{profitPercent}})</text>
      </view>
    </view>

    <!-- 称号徽章 (盖章效果) -->
    <view class="badge-stamp animate-bounce-in">
      <view class="stamp-inner {{badgeClass}}">
        <text class="emoji">{{badgeEmoji}}</text>
      </view>
      <view class="badge-info">
        <text class="rank">RANKING</text>
        <text class="name text-glow-gold">{{badgeTitle}}</text>
      </view>
    </view>
    
    <view class="divider-line"></view>

    <text class="quote-text">{{badgeSubtitle}}</text>
  </view>

  <!-- 中部分：数据网格 -->
  <view class="stats-grid animate-fade-in" style="animation-delay: 0.2s">
    <!-- 关键数据 -->
    <view class="stat-box glass-card-light">
      <text class="label">WIN RATE</text>
      <text class="value din-font">{{winCount + loseCount > 0 ? ((winCount / (winCount + loseCount)) * 100).toFixed(0) : 0}}%</text>
    </view>
    
    <view class="stat-box glass-card-light">
      <text class="label">DODGE</text>
      <text class="value din-font">{{dodgeCount}}</text>
    </view>

    <view class="stat-box glass-card-light">
      <text class="label">TRADES</text>
      <text class="value din-font">{{buyCount}}</text>
    </view>

    <view class="stat-box glass-card-light">
      <text class="label">MISS</text>
      <text class="value din-font">{{missCount}}</text>
    </view>
  </view>

  <!-- 下部分：成就列表 -->
  <view class="achievements-area animate-fade-in" style="animation-delay: 0.4s" wx:if="{{achievements.length > 0}}">
    <view class="section-title">ACHIEVEMENTS UNLOCKED</view>
    <view class="achievement-card glass-card-light" wx:for="{{achievements}}" wx:key="index">
      <view class="icon-box">{{item.icon}}</view>
      <view class="info">
        <text class="title">{{item.title}}</text>
        <text class="desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作区 -->
  <view class="action-footer animate-fade-in" style="animation-delay: 0.6s">
    <button class="cyber-btn btn-restart" bindtap="playAgain">
      <text>RESTART SYSTEM</text>
    </button>
    <button class="cyber-btn btn-share" open-type="share">
      <text>SHARE REPORT</text>
    </button>
  </view>
</view>
