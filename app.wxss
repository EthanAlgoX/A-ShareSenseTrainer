/* app.wxss - 全局样式 */

/* CSS 变量定义 */
page {
  --color-rise: #ef232a;       /* A股涨 - 红色 */
  --color-fall: #14b143;       /* A股跌 - 绿色 */
  --color-primary: #e63946;    /* 主题色 */
  --color-secondary: #f4a261;  /* 次要色 */
  --color-bg-dark: #0f0f1a;    /* 深色背景 */
  --color-bg-card: #1a1a2e;    /* 卡片背景 */
  --color-bg-light: #252542;   /* 浅色背景 */
  --color-text-primary: #ffffff;
  --color-text-secondary: #a0a0b0;
  --color-gold: #ffd700;
  --color-ma5: #f9c80e;        /* MA5 黄色 */
  --color-ma10: #9b5de5;       /* MA10 紫色 */
  --color-ma20: #00bbf9;       /* MA20 蓝色 */
  
  background-color: var(--color-bg-dark);
  color: var(--color-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  min-height: 100vh;
}

/* 通用容器 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background: linear-gradient(135deg, var(--color-bg-card) 0%, var(--color-bg-light) 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 16rpx 0;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

/* 按钮基础样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 48rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 买入按钮 - 红色 */
.btn-buy {
  background: linear-gradient(135deg, #ef232a 0%, #ff6b6b 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(239, 35, 42, 0.4);
}

/* 观望按钮 - 灰色 */
.btn-wait {
  background: linear-gradient(135deg, #4a4a6a 0%, #6a6a8a 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(74, 74, 106, 0.4);
}

/* 金额显示 */
.amount {
  font-family: 'DIN Alternate', 'Helvetica Neue', Arial, sans-serif;
  font-weight: 700;
}

.amount-rise {
  color: var(--color-rise);
}

.amount-fall {
  color: var(--color-fall);
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}

.animate-fadeIn {
  animation: fadeIn 0.5s ease-out;
}

.animate-pulse {
  animation: pulse 2s infinite;
}

.animate-shake {
  animation: shake 0.5s ease-in-out;
}
