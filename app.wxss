/* app.wxss - 全局样式 (Cyber-Finance) */

/* CSS 变量定义 */
page {
  /* 基础色板 */
  --bg-deep: #0B0B15;      /* 深空底色 */
  --bg-surface: #16162A;   /* 表面色 */
  
  /* 霓虹强调色 */
  --neon-gold: #FFD700;    /* 金色 */
  --neon-red: #FF4D4D;     /* 涨/亏损 */
  --neon-green: #00E676;   /* 跌/盈利 (A股把绿色定义为跌，但配色上我们用亮绿色表示盈利/通过) */
  --neon-blue: #00F0FF;    /* 科技蓝 */
  
  /* 文本颜色 */
  --text-primary: #FFFFFF;
  --text-secondary: rgba(255, 255, 255, 0.7);
  --text-muted: rgba(255, 255, 255, 0.4);

  /* 字体 */
  --font-num: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  
  /* 全局设置 */
  background-color: var(--bg-deep);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  min-height: 100vh;
}

/* 布局工具 */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* --- 核心设计语言：毛玻璃 (Glassmorphism) --- */
.glass-card {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.glass-card-light {
  background: rgba(255, 255, 255, 0.05); /* 更亮 */
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

/* --- 核心设计语言：霓虹光效 (Neon Glow) --- */
.text-glow-gold {
  color: var(--neon-gold);
  text-shadow: 0 0 16rpx rgba(255, 215, 0, 0.6);
}

.text-glow-red {
  color: var(--neon-red);
  text-shadow: 0 0 16rpx rgba(255, 77, 77, 0.6);
}

.text-glow-green {
  color: var(--neon-green);
  text-shadow: 0 0 16rpx rgba(0, 230, 118, 0.6);
}

/* 按钮样式体系 */
.btn-primary {
  background: linear-gradient(135deg, #FFD700 0%, #FFAA00 100%);
  color: #0B0B15;
  font-weight: bold;
  box-shadow: 0 0 24rpx rgba(255, 215, 0, 0.4);
  border: none;
  font-family: var(--font-num); /* 使用数字字体更有科技感 */
  letter-spacing: 2rpx;
}

.btn-danger {
  background: linear-gradient(135deg, #FF4D4D 0%, #FF0000 100%);
  color: #FFF;
  box-shadow: 0 0 24rpx rgba(255, 77, 77, 0.4);
}

.btn-success {
  background: linear-gradient(135deg, #00E676 0%, #00C853 100%);
  color: #0B0B15;
  box-shadow: 0 0 24rpx rgba(0, 230, 118, 0.4);
}

/* 数字专用 */
.din-font {
  font-family: var(--font-num);
}

/* 动画库 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulse-glow {
  0% { box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.2); }
  50% { box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.5); }
  100% { box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.2); }
}

.animate-fade-in {
  animation: fadeIn 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}

.animate-pulse {
  animation: pulse-glow 2s infinite;
}
